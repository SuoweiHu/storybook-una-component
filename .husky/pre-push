# Run the Storybook component tests (play functions + a11y) before pushing.
# --run stops Vitest from starting in watch mode. Skip once with: git push --no-verify
npm run test-storybook -- --run

# Publish Storybook to Chromatic and run visual tests (only if the tests above passed).
# --exit-zero-on-changes: visual changes don't block the push; review them in Chromatic.
# Build errors (e.g. a story that fails to render) still block it.
npm run chromatic -- --exit-zero-on-changes
